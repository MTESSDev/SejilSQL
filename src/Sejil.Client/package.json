{
  "name": "sejil-client",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Interface de consultation de SejilSQL (Vue 3). Le build produit un seul fichier index.html, embarqué dans la bibliothèque.",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "embed": "npm run build && node scripts/embed.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
}
