<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Summary>A pluggable logs viewer</Summary>
    <Description>Collect the logs of your ASP.NET Core applications in SQL Server (Serilog) and browse, search and filter them in a web viewer served by the application itself. Fork of Sejil by Alaa Masoud.</Description>
    <Authors>Alaa Masoud, Dany Côté</Authors>
    <Copyright>Copyright © Alaa Masoud</Copyright>
    <PackageId>SejilSQL</PackageId>
    <PackageTags>sejil;logging;logs;serilog;sqlserver;aspnetcore;log-viewer</PackageTags>
    <PackageProjectUrl>https://github.com/MTESSDev/SejilSQL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MTESSDev/SejilSQL</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>3.1.3</VersionPrefix>
    <AssemblyName>SejilSQL</AssemblyName>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <DebugType>full</DebugType>
    <RootNamespace>SejilSQL</RootNamespace>
    <Version>3.1.3</Version>
    <Product>SejilSQL</Product>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <FileVersion>3.1.3.0</FileVersion>
  </PropertyGroup>


  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ben.Demystifier" Version="0.4.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Dapper.Contrib" Version="2.0.78" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.PeriodicBatching" Version="5.0.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="index.html" />
    <EmbeddedResource Include="db.sql" />
  </ItemGroup>

</Project>
